@model List<Employee>

<h2>@ViewBag.PageTitle</h2>

<p>Total Employees: @ViewBag.TotalEmployees</p>

<p><a asp-controller="Employee" asp-action="Create">Add New Employee</a></p>

@if (Model.Count == 0)
{
    <p>No employees found.</p>
}
else
{
    @await Html.PartialAsync("_EmployeeTable", Model)
}
